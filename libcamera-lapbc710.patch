 } /* namespace */
 
+/*
+ * The LAPBC710 delivers unpacked 10-bit RGB-IR with this repeating tile:
+ *
+ *     I G I G
+ *     G B G R
+ *     I G I G
+ *     G R G B
+ *
+ * Rotate the sensor image 180 degrees as we reconstruct an RGGB mosaic.
+ * Keep measured green pixels and interpolate chroma from nearby samples
+ * of the same color. Infrared samples are excluded from color and stats.
+ */
+void DebayerCpu::remosaicLapbc710(const uint8_t *src)
+{
+	const unsigned int stride = inputConfig_.stride / 2;
+	const unsigned int width = rgbIrSize_.width;
+	const unsigned int height = rgbIrSize_.height;
+	const auto *raw = reinterpret_cast<const uint16_t *>(src);
+	const auto isRed = [](unsigned int x, unsigned int y) {
+		return ((x ^ y) & 2) != 0;
+	};
+
+	for (unsigned int y = 0; y < height; ++y) {
+		const unsigned int sy = height - 1 - y;
+		const auto *row = raw + sy * stride;
+		auto *dst = rgbIrBayer_.data() + y * stride;
+
+		for (unsigned int x = 0; x < width; ++x) {
+			const unsigned int sx = width - 1 - x;
+			if ((x ^ y) & 1) {
+				dst[x] = row[sx];
+			} else if (!(y & 1)) {
+				if (isRed(sx, sy)) {
+					dst[x] = row[sx];
+				} else {
+					const unsigned int left = sx >= 2 ? sx - 2 : sx + 2;
+					const unsigned int right = sx + 2 < width ? sx + 2 : left;
+					dst[x] = (row[left] + row[right] + 1) / 2;
+				}
+			} else {
+				const unsigned int above = sy ? sy - 1 : 1;
+				const unsigned int below = sy + 1;
+				const auto blue = [&](unsigned int line) {
+					unsigned int column = sx + 1;
+					if (isRed(column, line))
+						column = sx ? sx - 1 : sx + 3;
+					return raw[line * stride + column];
+				};
+				dst[x] = (blue(above) + blue(below) + 1) / 2;
+			}
+		}
+	}
+}
